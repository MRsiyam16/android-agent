# Root-level ignores. The android-agent/ subtree has its own .gitignore, which still
# applies to everything under it — patterns there are relative to that file, so
# `projects/`, `.env` and `test_*.py` keep working unchanged after the repo root moved up.

# Claude Code local state: settings.json is shared project config and IS tracked;
# the rest is per-machine and would only cause conflicts.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/launch.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
desktop.ini
