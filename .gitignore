# Repo root. Almost nothing lives here on purpose — README and the launcher are what a
# user needs, and app/ holds the rest. The project's own ignore rules are in
# app/.gitignore, relative to that directory.

# Claude Code local state: settings.json is shared project config and IS tracked;
# the rest is per-machine and would only cause conflicts.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/launch.json

# Python / editors / OS, in case anything is ever run from here.
__pycache__/
*.py[cod]
.venv/
venv/
env/

.vscode/
.idea/
*.swp
*.swo
*~

Thumbs.db
.DS_Store
desktop.ini
